@page "/admin-home"
@using HotelManagementSystem_Web.Layout.AdminLayout
@layout AdminLayout
@inject IJSRuntime JSRuntime

<h3>Dashboard</h3>
<hr/>
<div class="row">
    <div class="col-4">
        <div class="card">
            <div class="card-header fw-bolder">Sources Of Booking</div>
            <div class="card-body" style="height: 300px">
                <div id="pieChartSourcesBooking"></div>
            </div>
        </div>
    </div>
    <div class="col-8">
        <div class="card">
            <div class="card-header fw-bold">Total Count</div>
            <div class="card-body" style="height: 300px">
                <div id="barChartCount"></div>
            </div>
        </div>
    </div>

</div>
<div class="row">
    <div class="col-6">
        <div class="card">
            <div class="card-header fw-bolder">Room Type Booking Count By Months</div>
            <div class="card-body" style="height: 320px;">
                <div class="card-body" id="ColumnChartRoomType"></div>
            </div>
        </div>

    </div>
    <div class="col-6">
        <div class="card">
            <div class="card-header fw-bolder">Monthly Sales Of Booking</div>
            <div class="card-body" style="height: 320px;">
                <div class="" id="LineChartSale"></div>
            </div>
        </div>

    </div>
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("setColumnChartRoomType");
            await JSRuntime.InvokeVoidAsync("setLineChartSale");
            await JSRuntime.InvokeVoidAsync("setPieChartSourcesBooking");
            await JSRuntime.InvokeVoidAsync("setBarChartCount");
        }
    }

}


