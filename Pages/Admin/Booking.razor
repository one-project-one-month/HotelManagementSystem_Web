@page "/admin/booking"
@inject IJSRuntime JS
@using HotelManagementSystem_Web.Layout.AdminLayout
@layout AdminLayout

<h3 class="text-center mb-4" style="color: #e60000;">Bookings Management</h3>

@if (isLoaded)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">

            <select class="form-select" @bind="selectedStatus">
                <option value="" disabled selected>---Select Booking Status---</option>
                <option value="">Booked</option>
                <option value="True">Cancelled</option>

            </select>
            <button class="btn btn-danger" @onclick="ApplyFilter">Filter</button>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-danger" @onclick="ToggleActionColumn">
                <i class="bi bi-pencil"></i> Edit
            </button>
            <button class="btn btn-danger" @onclick="OpenAddModal">+ Add Booking</button>
        </div>
    </div>

    <!-- Booking Table -->
    <table class="table table-bordered align-middle" style="background-color: #fff0f0;">
        <thead style="background-color: #ffe6e6;">
            <tr>
                <th class="ps-2">Name</th>
                <th class="ps-2">Nrc</th>
                <th class="ps-2">PhoneNo</th>
                <th class="ps-2">GuestCount</th>
                <th class="ps-2">CheckIn </th>
                <th class="ps-2">CheckOut</th>
                <th class="ps-2">Deposit Amount</th>
                <th class="ps-2">Booking Status</th>
                <th class="ps-2">Total Amount</th>
                <th class="ps-2">Payment Type</th>
                @if (showActionColumn)
                {
                    <th class="text-center">Actions</th>
                }
            </tr>
        </thead>
        <tbody style="background-color: white;">
            @foreach (var booking in filteredBookings.Skip((currentPage - 1) * pageSize).Take(pageSize))
            {
                <tr>
                    <td class="ps-2">@booking.Name</td>
                    <td class="ps-2">@booking.Nrc</td>
                    <td class="ps-2">@booking.PhoneNo</td>
                    <td class="ps-2">@booking.GuestCount</td>
                    <td class="ps-2">@booking.CheckInTime</td>
                    <td class="ps-2">@booking.CheckOutTime</td>
                    <td class="ps-2">@booking.DepositAmount</td>
                    <td class="ps-2">@booking.BookingStatus</td>
                    <td class="ps-2">@booking.TotalAmount</td>
                    <td class="ps-2">@booking.PaymentType</td>

                    @if (showActionColumn)
                    {
                        <td class="text-center">
                            <button class="btn btn-outline-info btn-sm py-1 me-2" @onclick="() => OpenEditModal(booking)">Reserve
                            </button>
                            <button class="btn btn-outline-primary btn-sm py-1 me-2" @onclick="() => OpenEditModal(booking)">Edit
                            </button>
                            <button class="btn btn-outline-danger btn-sm py-1" @onclick="() => DeleteBooking(booking.UserId)">Delete
                            </button>
                        </td>
                    }
                </tr>
            }
    </tbody>
</table>

<!-- Previous and Next Page -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <button class="btn btn-light" @onclick="PreviousPage" disabled="@(!CanGoBack)">Previous</button>
    <span>Page @currentPage of @totalPages</span>
    <button class="btn btn-light" @onclick="NextPage" disabled="@(!CanGoForward)">Next</button>
</div>

<!-- Add/Edit Booking Modal -->
<div class="modal fade " id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true"
    style="margin-top: 52px;">
    <div class="modal-dialog">
        <div class="modal-content">
            <EditForm class="edit-form" Model="editBooking" OnValidSubmit="SaveBooking">
                <DataAnnotationsValidator />
                <div class="modal-header">
                    <h5 class="modal-title" id="bookingModalLabel">
                        @(editBooking?.GuestId == Guid.Empty
                                                ? "Add Booking"
                                                : $"Edit Booking #{editBooking?.GuestId}")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                        @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <ValidationSummary />
                    <input type="text" @bind="editBooking.UserId" style="display: none" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Name</label>
                                <input type="text" class="form-control" placeholder="Name ..." @bind="editBooking.Name" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">NRC</label>
                                <input type="text" class="form-control" placeholder="12/XXX(N)XXXXXX"
                                    @bind="editBooking.Nrc" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Phone Number</label>
                                <input type="text" class="form-control" placeholder="09-XXXXXXXXXX"
                                    @bind="editBooking.PhoneNo" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Guest Count</label>
                                <input type="number" class="form-control" placeholder="Guest Count"
                                    @bind="editBooking.GuestCount" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Check In</label>
                                <input type="date" class="form-control" @bind="editBooking.CheckInTime" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Check Out</label>
                                <input type="date" class="form-control" @bind="editBooking.CheckOutTime" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Booking Status</label>
                                <select class="form-control" @bind="editBooking.BookingStatus">
                                    <option value="Booked">Booked</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Payment Type</label>
                                <select class="form-control" @bind="editBooking.PaymentType">
                                    <option value="" disabled selected>Please Choose One</option>
                                    <option value="Mobile Banking">Mobile Banking</option>
                                    <option value="Card">Card</option>
                                    <option value="Cash">Cash</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Deposit Amount</label>
                                <input type="number" class="form-control" placeholder="Deposit Amount"
                                    @bind="editBooking.DepositAmount" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label mb-1">Total Amount</label>
                                <input type="number" class="form-control" placeholder="Total Amount"
                                    @bind="editBooking.TotalAmount" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CloseModal">Close
                        </button>
                        <button type="submit" class="btn btn-danger">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}
else
{
    <p>Loading...</p>
}

@code {
    private List<TblBooking> bookings = new();
    private List<TblBooking> filteredBookings = new();

    private string selectedStatus = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private List<string> roomTypes = new() { "Single", "Double", "Suite" };
    private bool showActionColumn = false;
    private bool isLoaded = false;
    private Guid _userId = new Guid();

    private TblBooking editBooking = new TblBooking();

    private int totalPages => (int)Math.Ceiling((double)(filteredBookings?.Count ?? 0) / pageSize);
    private bool CanGoBack => currentPage > 1;
    private bool CanGoForward => currentPage < totalPages;

    protected override async Task OnInitializedAsync()
    {
        try
        {

            TblBooking booking = new TblBooking()
            {
                GuestId = Guid.NewGuid(),
                Name = "John Doe",
                Nrc = "12/ABC(N)123456",
                PhoneNo = "09-123456789",
                GuestCount = 2,
                CheckInTime = DateOnly.FromDateTime(DateTime.Now),
                CheckOutTime = DateOnly.FromDateTime(DateTime.Now.AddDays(2)),
                DepositAmount = 100.00m,
                BookingStatus = "Booked",
                TotalAmount = 200.00m,
                PaymentType = "Mobile Banking"
            };

            bookings.Add(booking);
            filteredBookings = bookings;
            isLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private void SearchBookings()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredBookings = bookings
        .Where(b =>
        string.IsNullOrEmpty(selectedStatus) ||
        b.BookingStatus?.Equals(selectedStatus, StringComparison.OrdinalIgnoreCase) == true
        )
        .ToList();

        currentPage = 1;


    }

    private void ToggleActionColumn()
    {
        showActionColumn = !showActionColumn;
    }

    private async Task OpenAddModal()
    {
        try
        {
            editBooking = new TblBooking
            {
                GuestId = null,
                Name = string.Empty,
                Nrc = string.Empty,
                PhoneNo = string.Empty,
                GuestCount = null,
                CheckInTime = null,
                CheckOutTime = null,
                DepositAmount = null,
                BookingStatus = string.Empty,
                TotalAmount = null,
                PaymentType = string.Empty
            };

            await ShowModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OpenAddModal: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private async Task OpenEditModal(TblBooking booking)
    {
        try
        {
            editBooking = new TblBooking
            {
                Name = booking.Name,
                Nrc = booking.Nrc,
                PhoneNo = booking.PhoneNo,
                GuestCount = booking.GuestCount,
                CheckInTime = booking.CheckInTime,
                CheckOutTime = booking.CheckOutTime,
                BookingStatus = booking.BookingStatus,
                TotalAmount = booking.TotalAmount,
                DepositAmount = booking.DepositAmount,
                PaymentType = booking.PaymentType,
            };

            await ShowModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OpenEditModal: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private async Task ShowModal()
    {
        try
        {
            var modal = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
            "bootstrap.Modal.getOrCreateInstance", "#bookingModal");
            await modal.InvokeVoidAsync("show");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ShowModal: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            var modal = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("bootstrap.Modal.getOrCreateInstance",
            "#bookingModal");
            await modal.InvokeVoidAsync("hide");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CloseModal: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private async Task SaveBooking()
    {


        ApplyFilter();
        await CloseModal();
        StateHasChanged();

    }

    private void DeleteBooking(Guid? bookingId)
    {

    }

    private void PreviousPage()
    {
        if (CanGoBack)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (CanGoForward)
        {
            currentPage++;
        }
    }

    public class TblBooking
    {
        public Guid? UserId { get; set; }

        public Guid? GuestId { get; set; }

        public string Name { get; set; } = null!;
        public string Nrc { get; set; } = null!;

        public string PhoneNo { get; set; } = null!;

        public int? GuestCount { get; set; }

        public DateOnly? CheckInTime { get; set; }

        public DateOnly? CheckOutTime { get; set; }

        public decimal? DepositAmount { get; set; }

        public string? BookingStatus { get; set; }

        public decimal? TotalAmount { get; set; }
        public string? PaymentType { get; set; }
    }

}