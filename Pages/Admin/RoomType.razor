@page "/admin/room-type"
@using HotelManagementSystem_Web.Layout.AdminLayout
@layout AdminLayout

<h3 class="text-center my-4 text-danger">Room Type Details</h3>


<div class="d-flex justify-content-end mb-1">
    <button class="btn btn-outline-danger btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addRoomTypeModal">
        <i class="bi bi-plus"></i> Add Room Type
    </button>
</div>

@if (ChunkedRoomTypes.Count > 0)
{
    <div class="position-relative">
        <!-- Carousel container -->
        <div id="roomTypeCarousel" class="carousel slide mb-2" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < ChunkedRoomTypes.Count; i++)
                {
                    var group = ChunkedRoomTypes[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="container shadow-lg py-3">
                            <div class="row justify-content-center">
                                @foreach (var room in group)
                                {
                                    <div class="col-12 col-md-4 mb-3">
                                        <div class="card h-100 shadow-sm">
                                            <img src="@room.RoomImg ?? defaultImage"
                                                 class="card-img-top"
                                                 alt="@room.RoomTypeName"
                                                 style="height: 180px; object-fit: cover;" />
                                            <div class="card-body">
                                                <h5 class="card-title">@room.RoomTypeName</h5>
                                                <p class="card-text">@room.Description</p>
                                                <p class="fw-bold">@room.Price?.ToString("C")</p>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenEditModal(room)">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => OpenUploadPhotoModal(room)">
                                                        <i class="bi bi-arrow-bar-up"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Separate nav buttons OUTSIDE carousel -->
        <div class="d-flex justify-content-between mt-2 px-3">
            <button class="btn btn-outline-danger" type="button" data-bs-target="#roomTypeCarousel" data-bs-slide="prev">
                <i class="bi bi-arrow-left"></i> Prev
            </button>
            <button class="btn btn-outline-danger" type="button" data-bs-target="#roomTypeCarousel" data-bs-slide="next">
                Next <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
}



