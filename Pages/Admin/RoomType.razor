<!-- Edit Room Type Modal -->
@if (showEditModal && editingRoomType != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Room Type</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="editingRoomType" OnValidSubmit="SaveRoomType">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">Room Type Name</label>
                            <InputText class="form-control" @bind-Value="editingRoomType.RoomTypeName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="editingRoomType.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <InputNumber class="form-control" @bind-Value="editingRoomType.Price" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-danger ms-2" @onclick="CloseModals">Cancel</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Upload Photo Modal -->
@if (showUploadPhotoModal && uploadingRoomType != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Photo for @uploadingRoomType.RoomTypeName</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <InputFile OnChange="HandleFileSelected" />
                    @if (uploadPreviewUrl != null)
                    {
                        <img src="@uploadPreviewUrl" class="img-fluid mt-3" alt="Preview" />
                    }
                    <div class="mt-3 d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-danger" @onclick="UploadPhoto">Upload</button>
                        <button class="btn btn-danger" @onclick="CloseModals">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TblRoomType> roomTypes = new()
    {
        new TblRoomType
        {
            Id = 1,
            RoomTypeName = "Deluxe Suite",
            Description = "Spacious room with a king bed, sea view, and jacuzzi.",
            Price = 250.00M,
            RoomImg = "https://hotel-rooms-img.s3.ap-southeast-2.amazonaws.com/Flux_Dev_A_luxury_bamboo_hotel_cottage_with_a_kingsized_bed_wi_0.jpg"
        },
        new TblRoomType
        {
            Id = 2,
            RoomTypeName = "Standard Room",
            Description = "Comfortable room with queen bed and city view.",
            Price = 150.00M,
            RoomImg = "https://hotel-rooms-img.s3.ap-southeast-2.amazonaws.com/Flux_Dev_A_luxury_bamboo_hotel_cottage_with_a_kingsized_bed_wi_0.jpg"
        },
        new TblRoomType
        {
            Id = 3,
            RoomTypeName = "Family Suite",
            Description = "Large room with double beds and a living area.",
            Price = 320.00M,
            RoomImg = "https://hotel-rooms-img.s3.ap-southeast-2.amazonaws.com/Flux_Dev_A_luxury_bamboo_hotel_cottage_with_a_kingsized_bed_wi_0.jpg"
        },
        new TblRoomType
        {
            Id = 4,
            RoomTypeName = "Budget Room",
            Description = "Affordable room with essential amenities.",
            Price = 100.00M,
            RoomImg = "https://hotel-rooms-img.s3.ap-southeast-2.amazonaws.com/Flux_Dev_A_luxury_bamboo_hotel_cottage_with_a_kingsized_bed_wi_0.jpg"
        }
    };

    private string defaultImage = "https://hotel-rooms-img.s3.ap-southeast-2.amazonaws.com/Flux_Dev_A_luxury_bamboo_hotel_cottage_with_a_kingsized_bed_wi_0.jpg";

    private bool showEditModal = false;
    private bool showUploadPhotoModal = false;

    private TblRoomType? editingRoomType;
    private TblRoomType? uploadingRoomType;

    private IBrowserFile? selectedFile;
    private string? uploadPreviewUrl;

    void OpenEditModal(TblRoomType roomType)
    {
        editingRoomType = new TblRoomType
            {
                Id = roomType.Id,
                RoomTypeName = roomType.RoomTypeName,
                Description = roomType.Description,
                Price = roomType.Price,
                RoomImg = roomType.RoomImg,
                RoomImgMimeType = roomType.RoomImgMimeType
            };
        showEditModal = true;
    }

    void OpenUploadPhotoModal(TblRoomType roomType)
    {
        uploadingRoomType = roomType;
        uploadPreviewUrl = null;
        selectedFile = null;
        showUploadPhotoModal = true;
    }

    void CloseModals()
    {
        showEditModal = false;
        showUploadPhotoModal = false;
        editingRoomType = null;
        uploadingRoomType = null;
        uploadPreviewUrl = null;
        selectedFile = null;
    }

    void SaveRoomType()
    {
        if (editingRoomType != null)
        {
            var roomIndex = roomTypes.FindIndex(r => r.Id == editingRoomType.Id);
            if (roomIndex != -1)
            {
                roomTypes[roomIndex] = editingRoomType;
            }
        }
        CloseModals();
    }

    async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        var buffer = new byte[selectedFile.Size];
        await selectedFile.OpenReadStream().ReadAsync(buffer);
        uploadPreviewUrl = $"data:{selectedFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    void UploadPhoto()
    {
        if (uploadingRoomType != null && selectedFile != null && uploadPreviewUrl != null)
        {
            uploadingRoomType.RoomImg = uploadPreviewUrl;
            uploadingRoomType.RoomImgMimeType = selectedFile.ContentType;
            CloseModals();
        }
    }

    private List<List<TblRoomType>> ChunkedRoomTypes => roomTypes
        .Select((room, index) => new { room, index })
        .GroupBy(x => x.index / 3) // 3 cards per carousel slide
        .Select(g => g.Select(x => x.room).ToList())
        .ToList();

    public class TblRoomType
    {
        public int Id { get; set; }
        public string? RoomTypeName { get; set; }
        public string? Description { get; set; }
        public decimal? Price { get; set; }
        public string? RoomImg { get; set; }
        public string? RoomImgMimeType { get; set; }
    }
}
